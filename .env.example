# ═══════════════════════════════════════════════════════════════
# NEUROLEARN AI — ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to version control
# ═══════════════════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/neurolearn"

# ─── NextAuth ─────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate a strong secret: openssl rand -base64 64
NEXTAUTH_SECRET="change-me-to-a-random-secret-at-least-32-chars"

# ─── Google OAuth 2.0 (Optional) ──────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── AI Services ──────────────────────────────────────────────
# Google Gemini API Key (get from https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=""

# ─── AI Service URLs ──────────────────────────────────────────
# FastAPI backend URL (Python document processor)
NEXT_PUBLIC_AI_SERVICE_URL="http://127.0.0.1:8000"
FASTAPI_URL="http://127.0.0.1:8000"

# ─── SMTP (Optional - for password reset emails) ──────────────
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@neurolearn.ai"
